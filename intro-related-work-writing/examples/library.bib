@article{smith2020gas,
  author = {Smith, John and Tanaka, Ken},
  title = {A benchmark dataset for gas uptake prediction in metal-organic frameworks},
  journal = {Journal of Materials Data},
  year = {2020},
  doi = {10.1000/jmd.2020.001},
  abstract = {We introduce a benchmark dataset of 12 metal-organic frameworks and their gas uptake isotherms to define the task of uptake prediction. The dataset provides a common problem setting for method comparison. However, these models are limited to single-component adsorption.}
}

@article{li2021gnn,
  author = {Li, Mei and Zhou, Hao},
  title = {Graph neural network models for predicting adsorption isotherms},
  journal = {Computational Materials Science},
  year = {2021},
  doi = {10.1000/cms.2021.114},
  abstract = {We propose a graph neural network model that predicts adsorption isotherms from framework structures. The model is trained on 8 frameworks and evaluated with a held-out split. However, these models are limited to single-component adsorption.}
}

@article{chen2022cg,
  author = {Chen, Rui and Park, Min},
  title = {Coarse-grained model of flexible frameworks under humid conditions},
  journal = {Physical Chemistry Letters},
  year = {2022},
  doi = {10.1000/pcl.2022.220},
  abstract = {A coarse-grained model is developed to describe framework flexibility. Under humid conditions the model reproduces experimental swelling within 5 percent. However, our approach is limited to single-component systems.}
}

@article{wang2023transfer,
  author = {Wang, Fang and Ito, Sora},
  title = {Transfer learning for adsorption prediction with small datasets},
  journal = {AI for Materials},
  year = {2023},
  doi = {10.1000/aim.2023.33},
  abstract = {Transfer learning improves adsorption prediction when experimental data are scarce. The evaluation uses three baselines and reports mean absolute error. The approach is restricted to equilibrium conditions and cannot describe kinetics.}
}

@article{zhao2019exp,
  author = {Zhao, Lin},
  title = {High-throughput experiments for multicomponent gas separation},
  journal = {Separation Science},
  year = {2019},
  doi = {10.1000/sep.2019.87},
  abstract = {High-throughput experiments measure multicomponent selectivity in 40 frameworks. The evaluation metric is selectivity at 1 bar. The experiments only cover room temperature, which restricts extrapolation to other conditions.}
}

@article{kim2024flow,
  author = {Kim, Dae and Rossi, Luca},
  title = {Generative flow models for framework discovery},
  journal = {Nature Materials Letters},
  year = {2024},
  doi = {10.1000/nml.2024.9},
  abstract = {A generative flow model proposes new framework structures. The model is evaluated by simulated uptake and compared against two baselines. The approach cannot enforce synthesizability, so candidates require experimental validation.}
}
