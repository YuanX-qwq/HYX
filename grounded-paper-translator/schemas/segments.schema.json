{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "translation-segments/v1",
  "type": "object",
  "required": ["schema", "source", "segments", "stats"],
  "properties": {
    "schema": {"const": "translation-segments/v1"},
    "source": {
      "type": "object",
      "required": ["file", "sha256", "pages", "backend"],
      "properties": {
        "file": {"type": "string"},
        "sha256": {"type": "string"},
        "pages": {"type": "integer", "minimum": 1},
        "backend": {"enum": ["pymupdf", "pdfplumber", "pdftotext", "text"]}
      }
    },
    "typography": {"type": "object", "properties": {"body_size": {"type": "number"}}},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pid", "kind", "page", "bbox", "text", "sentences", "words"],
        "properties": {
          "pid": {"type": "string", "pattern": "^P[0-9]{4}$"},
          "kind": {
            "enum": ["title", "authors", "abstract", "heading", "body", "caption", "table",
                     "equation", "reference", "footnote", "figure-label", "fragment",
                     "header", "footer", "margin"]
          },
          "section": {"type": "string"},
          "section_level": {"type": "integer"},
          "page": {"type": "integer", "minimum": 1},
          "page_end": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "zone": {"type": "string"},
          "text": {"type": "string"},
          "sentences": {"type": "array", "items": {"type": "string"}},
          "words": {"type": "integer", "minimum": 0},
          "chars": {"type": "integer", "minimum": 0},
          "continued": {"type": "boolean"}
        }
      }
    },
    "stats": {
      "type": "object",
      "required": ["segments", "words", "pages", "translatable"],
      "properties": {
        "segments": {"type": "integer"},
        "words": {"type": "integer"},
        "pages": {"type": "integer"},
        "translatable": {"type": "integer"},
        "by_kind": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
