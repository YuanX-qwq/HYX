{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "glossary-lock/v1",
  "type": "object",
  "required": ["schema", "terms", "locked"],
  "properties": {
    "schema": {"const": "glossary-lock/v1"},
    "source": {"type": "string"},
    "locked": {"type": "boolean"},
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue"],
        "properties": {
          "line": {"type": "integer"},
          "issue": {"type": "string"},
          "term_en": {"type": "string"}
        }
      }
    },
    "stats": {"type": "object"},
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term_en", "term_zh", "locked"],
        "properties": {
          "term_en": {"type": "string", "minLength": 1},
          "term_zh": {"type": "string", "minLength": 1},
          "category": {"type": "string"},
          "variants": {"type": "array", "items": {"type": "string"}},
          "note": {"type": "string"},
          "locked": {"type": "boolean"}
        }
      }
    }
  }
}
