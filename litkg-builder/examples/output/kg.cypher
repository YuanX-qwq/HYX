// litkg export — 可直接导入 Neo4j
CREATE CONSTRAINT IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;
MERGE (n:Entity {id: "n001"}) SET n.label = "Cu-doped TiO2 samples", n.type = "material", n.sources = "P1";
MERGE (n:Entity {id: "n002"}) SET n.label = "at 25 °C", n.type = "condition", n.sources = "P1";
MERGE (n:Entity {id: "n003"}) SET n.label = "at 25 °C", n.type = "condition", n.sources = "P2";
MERGE (n:Entity {id: "n004"}) SET n.label = "undoped reference", n.type = "material", n.sources = "P1";
MERGE (n:Entity {id: "n005"}) SET n.label = "undoped reference", n.type = "material", n.sources = "P2";
MERGE (n:Entity {id: "n006"}) SET n.label = "45 umol g-1 h-1", n.type = "metric", n.sources = "P1";
MERGE (n:Entity {id: "n007"}) SET n.label = "impregnation", n.type = "method", n.sources = "P1";
MERGE (n:Entity {id: "n008"}) SET n.label = "DFT calculations", n.type = "method", n.sources = "P1|P2";
MERGE (n:Entity {id: "n009"}) SET n.label = "Cu-doped catalyst", n.type = "material", n.sources = "P1";
MERGE (n:Entity {id: "n010"}) SET n.label = "undoped catalyst", n.type = "material", n.sources = "P1";
MERGE (n:Entity {id: "n011"}) SET n.label = "61%", n.type = "metric", n.sources = "P1";
MERGE (n:Entity {id: "n012"}) SET n.label = "92%", n.type = "metric", n.sources = "P1";
MERGE (n:Entity {id: "n013"}) SET n.label = "92%", n.type = "metric", n.sources = "P2";
MERGE (n:Entity {id: "n014"}) SET n.label = "These results indicate that Cu doping stabilizes the active site.", n.type = "conclusion", n.sources = "P1";
MERGE (n:Entity {id: "n015"}) SET n.label = "We conclude that Cu-doped TiO2 is more active than the undoped reference at 25 °C, while the origin of the selectivity gap is not resolved h…", n.type = "conclusion", n.sources = "P1";
MERGE (n:Entity {id: "n016"}) SET n.label = "N-doped TiO2 samples", n.type = "material", n.sources = "P2";
MERGE (n:Entity {id: "n017"}) SET n.label = "at 15 °C", n.type = "condition", n.sources = "P2";
MERGE (n:Entity {id: "n018"}) SET n.label = "Cu-doped systems", n.type = "material", n.sources = "P2";
MERGE (n:Entity {id: "n019"}) SET n.label = "30 umol g-1 h-1", n.type = "metric", n.sources = "P2";
MERGE (n:Entity {id: "n020"}) SET n.label = "annealing", n.type = "method", n.sources = "P2";
MERGE (n:Entity {id: "n021"}) SET n.label = "gas chromatography", n.type = "method", n.sources = "P2";
MERGE (n:Entity {id: "n022"}) SET n.label = "N-doped catalyst", n.type = "material", n.sources = "P2";
MERGE (n:Entity {id: "n023"}) SET n.label = "88%", n.type = "metric", n.sources = "P2";
MERGE (n:Entity {id: "n024"}) SET n.label = "Li Wei", n.type = "researcher", n.sources = "P2";
MERGE (n:Entity {id: "n025"}) SET n.label = "Cu-doped catalysts", n.type = "material", n.sources = "P2";
MERGE (n:Entity {id: "n026"}) SET n.label = "Cu-doped system", n.type = "material", n.sources = "P2";
MERGE (n:Entity {id: "n027"}) SET n.label = "These results show that N-doped TiO2 is active at 15 °C, but a direct comparison with the Cu-doped system tested at 25 °C cannot be made fro…", n.type = "conclusion", n.sources = "P2";
MATCH (a:Entity {id: "n006"}), (b:Entity {id: "n004"}) MERGE (a)-[:OUTPERFORMS {evidence_paragraph: "P1-p001"}]->(b);
MATCH (a:Entity {id: "n009"}), (b:Entity {id: "n010"}) MERGE (a)-[:OUTPERFORMS {evidence_paragraph: "P1-p003"}]->(b);
MATCH (a:Entity {id: "n022"}), (b:Entity {id: "n005"}) MERGE (a)-[:OUTPERFORMS {evidence_paragraph: "P2-p003"}]->(b);